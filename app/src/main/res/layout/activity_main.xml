<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CarBridge — Orquestador de Hotspot"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/modeCarplayBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ CarPlay (iPhone)" />

            <Button
                android:id="@+id/modeAndroidautoBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ Android Auto" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/systemHotspotCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hotspot del sistema (SSID y clave FIJOS, configurados en Ajustes)"
            android:paddingTop="6dp" />

        <Button
            android:id="@+id/openHotspotSettingsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir Ajustes de hotspot del sistema" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Banda del hotspot"
            android:paddingTop="8dp" />

        <Spinner
            android:id="@+id/bandSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SSID"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/ssidInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="CARBRIDGE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña (8-63, vacío = abierta)"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/passInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Canal (0 = automático)"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/channelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paquete del receptor a lanzar"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/receiverInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="com.shihab.diplay" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/presetDiplayBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usar DiPlay" />

            <Button
                android:id="@+id/presetDiautoBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usar DiAuto" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <Button
                android:id="@+id/permsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Permisos" />

            <Button
                android:id="@+id/statusBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Estado AP" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startHotspotBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Iniciar hotspot" />

            <Button
                android:id="@+id/launchReceiverBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lanzar receptor" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startBothBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Iniciar todo" />

            <Button
                android:id="@+id/stopBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detener" />
        </LinearLayout>

        <TextView
            android:id="@+id/credView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Red creada: (todavía no)"
            android:textStyle="bold"
            android:textSize="20sp"
            android:background="#2200AA00"
            android:padding="12dp"
            android:paddingTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nota: en Android 9 el SSID y la clave los asigna el sistema (no se pueden cambiar). Conecta el iPhone a la red que aparezca arriba."
            android:textSize="12sp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:textSize="20sp"
            android:padding="10dp"
            android:scrollbars="vertical" />

    </LinearLayout>
</ScrollView>
